{
  "name": "knowkanji",
  "version": "1.0.0",
  "private": true,
  "description": "Offline JLPT kanji study app (static web app + Android wrapper)",
  "scripts": {
    "sync": "python scripts/sync_www.py",
    "sync:android-assets": "python scripts/build_apk.py --assets-only",
    "cap:sync": "npx cap sync android",
    "build:apk": "python scripts/build_apk.py",
    "build:apk:docker": "python scripts/build_apk_docker.py",
    "test": "node tests/test_course.cjs && node tests/test_practice.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
